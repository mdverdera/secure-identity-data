{
  "IdentityProvider": {
    "Authority": "https://<identity-provider-host>",
    "Issuer": "https://<identity-provider-host>",
    "JwksUri": "https://<identity-provider-host>/.well-known/jwks.json"
  },
  "Jwt": {
    "Audience": "secure-identity-data-api"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=<supabase-host>;Database=<database>;Username=<username>;Password=<password>"
  },
  "AllowedOrigins": [
    "https://localhost:3000"
  ]
}
